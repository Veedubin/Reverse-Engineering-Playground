# =============================================================================
# RE_Playground — Environment configuration
# =============================================================================
#
# Copy this file to `.env` and fill in your real values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# DO NOT commit the real `.env` to version control — `.gitignore` excludes it.
# All values here are read by `.opencode/opencode.json` and passed to the
# relevant MCP servers.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM provider (Ollama Cloud)
# -----------------------------------------------------------------------------
# Base URL of the OpenAI-compatible API endpoint.
# Default for Ollama Cloud: https://ollama.com/v1
OLLAMA_BASE_URL=https://ollama.com/v1

# Your Ollama Cloud API key. Get one at https://ollama.com/settings/keys
# Required.
OLLAMA_API_KEY=your-ollama-cloud-api-key-here


# -----------------------------------------------------------------------------
# LLM provider (OpenRouter)
# -----------------------------------------------------------------------------
# Aggregates 200+ models (Anthropic, OpenAI, Google, Meta, etc.) behind a
# single OpenAI-compatible API. Get a key at https://openrouter.ai/keys
# Leave commented out if you don't use OpenRouter.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# -----------------------------------------------------------------------------
# LLM provider (Anthropic)
# -----------------------------------------------------------------------------
# Direct Anthropic API for Claude models. Get a key at https://console.anthropic.com/
# Leave commented out if you don't use Anthropic directly.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com


# -----------------------------------------------------------------------------
# LLM provider (OpenAI)
# -----------------------------------------------------------------------------
# Direct OpenAI API. Get a key at https://platform.openai.com/api-keys
# Leave commented out if you don't use OpenAI directly.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1


# -----------------------------------------------------------------------------
# LLM provider (Google AI)
# -----------------------------------------------------------------------------
# Direct Google AI (Gemini) API. Get a key at https://aistudio.google.com/apikey
# Leave commented out if you don't use Google directly.
# GOOGLE_API_KEY=your-google-ai-key-here
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# -----------------------------------------------------------------------------
# memini-ai (PostgreSQL + pgvector memory server)
# -----------------------------------------------------------------------------
# Postgres connection string. The default matches the docker-compose pattern
# shipped in memini-ai-dev (port 5434, user postgres, db postgres).
# Change the password and port to match your local install.
MEMINI_DB_URL=postgresql://postgres:password@localhost:5434/postgres

# Local filesystem path to a clone of https://github.com/Veedubin/memini-ai-dev
# Default (./memini-ai-dev) is the path relative to the .opencode/ directory.
# Override this if you keep memini-ai elsewhere on disk.
# MEMINI_AI_DIR=/path/to/memini-ai-dev


# -----------------------------------------------------------------------------
# Local LLM (used by memini-ai for extraction / summarization)
# -----------------------------------------------------------------------------
# Ollama local server. Only memini-ai reads these.
# Defaults are fine if you run `ollama serve` on the same machine.
# LLM_URL=http://localhost:11434/api/generate
# LLM_MODEL=llama3.2


# -----------------------------------------------------------------------------
# Optional: GitHub MCP server
# -----------------------------------------------------------------------------
# Only required if you enable the `github-mcp` server in opencode.json.
# The playground ships with it disabled; leave this commented out.
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here


# -----------------------------------------------------------------------------
# Optional: Ghidra MCP bridge script location
# -----------------------------------------------------------------------------
# Absolute path to the Ghidra MCP bridge script. Required for the `ghidra-mcp`
# server. Get the bridge from https://github.com/bethington/ghidra-mcp and
# clone it anywhere on disk. The default below matches the ghidra/Dockerfile.
# If you cloned the bridge to a different location, uncomment and update:
# GHIDRA_MCP_BRIDGE=/path/to/ghidra-mcp/bridge_mcp_ghidra.py


# -----------------------------------------------------------------------------
# Optional: Container resource overrides (multi-container stack only)
# -----------------------------------------------------------------------------
# Ghidra's JVM wants 3-4 GB. The default 4g works on most laptops. If you
# have a smaller box (e.g. 8 GB total), drop to 2g. If you have a 32 GB
# workstation and you're doing large multi-binary analysis, raise to 8g.
# GHIDRA_MEM_LIMIT=4g
